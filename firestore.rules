rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 128))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.highScore is number && data.highScore >= 0
        && data.highestWave is number && data.highestWave >= 0
        && data.totalKills is number && data.totalKills >= 0
        && data.gamesPlayed is number && data.gamesPlayed >= 0
        && data.credits is number && data.credits >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.pilotName is string && data.pilotName.size() > 0 && data.pilotName.size() <= 64
        && data.shipId is string && data.shipId.size() > 0 && data.shipId.size() <= 32
        && data.score is number && data.score >= 0
        && data.wave is number && data.wave >= 0
        && data.kills is number && data.kills >= 0
        && data.gameMode is string && data.gameMode.size() > 0 && data.gameMode.size() <= 32
        && data.timeSurvived is number && data.timeSurvived >= 0;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Leaderboard Collection
    match /leaderboard/{scoreId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(scoreId)
        && isValidLeaderboardEntry(incoming());
      allow update, delete: if false;
    }
  }
}
